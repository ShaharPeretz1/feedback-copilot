# PostgreSQL connection string (Neon in production, e.g. postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# Admin token gating all mutating/agent API routes (reads stay public). If unset, the gate
# is open (fine for local dev). Set a strong random value in production; enter it in the UI
# via the "Admin" button to make changes.
ADMIN_API_TOKEN=

# Anthropic API key for the triage agent
ANTHROPIC_API_KEY=

# Optional: override the model (defaults to claude-3-5-haiku-latest)
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Run agents on your Claude subscription instead of a metered API key (local only):
#   npm run triage:local   — uses the Claude Agent SDK via your logged-in `claude` CLI.
# Make sure ANTHROPIC_API_KEY is UNSET (it overrides subscription auth and bills the API).
# Optionally pin a non-interactive token instead of the CLI login (from `claude setup-token`):
# CLAUDE_CODE_OAUTH_TOKEN=

# Optional: GitHub token to export ops tasks as Issues (needs issues:write on the repo).
# Without it, the "Export to GitHub" button returns a clear "set GITHUB_TOKEN" message.
# GITHUB_TOKEN=
# Optional: target repo for exported issues (defaults to ShaharPeretz1/feedback-copilot)
# GITHUB_REPO=owner/repo
